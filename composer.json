{
    "name": "tobento/app-queue",
    "version": "2.0.1",
    "type": "library",
    "description": "Queue app support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "queue",
        "jobs"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/app-logging": "^2.0",
        "tobento/service-queue": "^2.0",
        "tobento/service-storage": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-filesystem": "^2.0",
        "tobento/app-event": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Queue\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Queue\\Test\\": "tests",
            "Tobento\\Service\\Queue\\Test\\": "vendor/tobento/service-queue/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}